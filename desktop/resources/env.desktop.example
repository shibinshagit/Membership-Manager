# Membership Portal — Desktop (offline) configuration
# Copied to the app user-data folder on first launch as config.env

# Embedded database — no PostgreSQL install required
DATABASE_DRIVER=pglite
# Optional override (defaults to the app user-data /db folder)
# PGLITE_DATA_DIR=

# JWT signing secret — change this on each install
AUTH_SECRET=change-this-desktop-secret

# First admin password created by automatic /api/setup on first launch
ADMIN_INITIAL_PASSWORD=Admin@12345

# Allows first-launch DB setup while NODE_ENV=production
SETUP_SECRET=desktop-setup-secret

DESKTOP_MODE=1
STORAGE_DRIVER=local
