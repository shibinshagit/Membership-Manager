DATABASE_URL=postgresql://username:password@localhost:5432/membership_portal
AUTH_SECRET=replace-with-strong-random-secret
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token
# Required in production to run /api/setup (use: /api/setup?secret=YOUR_SECRET)
SETUP_SECRET=replace-with-strong-random-secret
# Only used when /api/setup creates the first super admin (never commit a real value)
ADMIN_INITIAL_PASSWORD=

DESKTOP_MODE=1
DATABASE_DRIVER=pglite
STORAGE_DRIVER=local
# PGLITE_DATA_DIR=./data/pglite
# LOCAL_STORAGE_DIR=./data/uploads
